{
  "name": "pi-out-classify",
  "version": "0.1.0",
  "description": "Pi extension: filters large tool outputs (text, images, PDFs) down to what is relevant to the agent's task, using TypeSafe's Jev.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Piotr-Adamm",
    "url": "https://github.com/Piotr-Adamm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piotr-Adamm/pi-out-classify.git"
  },
  "homepage": "https://github.com/Piotr-Adamm/pi-out-classify#readme",
  "bugs": "https://github.com/Piotr-Adamm/pi-out-classify/issues",
  "keywords": ["pi-package", "pi-extension", "typesafe", "jev", "context", "tool-output", "pdf"],
  "files": ["index.ts", "src", "README.md", "LICENSE"],
  "scripts": {
    "format": "npx -y oxfmt --check",
    "format:fix": "npx -y oxfmt",
    "lint": "npx -y oxlint",
    "lint:fix": "npx -y oxlint --fix",
    "typecheck": "npx -y -p typescript tsc --noEmit -p ."
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0",
    "gpt-tokenizer": "^4.1.0",
    "pi-jevisual": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
